# Credenciais Omie. Nunca commitar valores reais.
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Segurança: escrita fica bloqueada por padrão.
OMIE_ALLOW_WRITES=false

# Base oficial da API.
OMIE_API_BASE=https://app.omie.com.br/api/v1

# Catálogo/documentação oficial.
OMIE_SERVICE_LIST_URL=https://developer.omie.com.br/service-list/

# Persistência local dos snapshots do radar de documentação.
OMIE_STATE_DIR=.omie_mcp_state

# Timeout HTTP em segundos.
OMIE_HTTP_TIMEOUT=45
